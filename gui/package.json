{
  "name": "dipm-gui",
  "private": true,
  "version": "0.0.1",
  "description": "Browser GUI for `dipm serve` (docs/gui.md, iterations 1 and 2)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "DIPM_SHOTS=1 playwright test e2e/screenshots.spec.ts e2e/iteration2.spec.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "preact": "10.29.8",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "20.19.43",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
